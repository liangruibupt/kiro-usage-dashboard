    "ssoInstanceArn": "arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxx",
    "subscriptionAppArn": "arn:aws:sso::<ACCOUNT_ID>:application/ssoins-xxxx/apl-xxxx",
    "groupCsvBucket": "kiro-user-activity-<ACCOUNT_ID>",
    "groupCsvKey": "lookup/user_groups.csv",
    "kiroSourceBucket": "kiro-user-activity-<ACCOUNT_ID>",
    "kiroSourcePrefix": "reports",
    "creditUnitPrice": "0.04",
    "topN": "15",
    "adminEmail": "admin@example.com",
    "sesSender": "verified-sender@example.com",
    "reportRecipients": "admin@example.com",
    "agentRuntimeArn": "arn:aws:bedrock-agentcore:<region>:<ACCOUNT_ID>:runtime/kiro_usage_agent-xxxxxxxxxx"
  }
